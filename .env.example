# backend/.env 로 복사해서 사용하세요: cp .env.example backend/.env
# docker-compose.yml 의 개발용 PostgreSQL(호스트 포트 5433) 기준 값입니다.
DATABASE_URL="postgresql://seon:seon_dev_pw@localhost:5433/seon_mes?schema=public"
# 통합 테스트(npm test)는 별도 DB를 사용합니다. 테스트 시작 시 마이그레이션 후 데이터를 비웁니다.
TEST_DATABASE_URL="postgresql://seon:seon_dev_pw@localhost:5433/seon_mes_test?schema=public"
PORT=4000
# 프론트엔드 개발 서버 주소 (CORS 허용)
CORS_ORIGIN="http://localhost:5173"
